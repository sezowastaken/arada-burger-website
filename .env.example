# Local development template.
# Copy to .env at the repo root (gitignored) and adjust as needed.
#
# This single root .env is the one source of truth for local Postgres/backend
# credentials — used by:
#   - infra/docker-compose.yml (via env_file, one per service)
#   - backend/drizzle.config.ts and backend/src/config/env.ts, when running
#     the backend directly on the host (npm run dev / db:migrate / db:seed)
#
# Host-side tools connect to Postgres via localhost, so DATABASE_URL below
# uses localhost:5432. Inside Docker Compose, the backend container overrides
# DATABASE_URL to point at the `postgres` service instead — see
# infra/docker-compose.yml. Don't duplicate these values into another file.

# PostgreSQL
POSTGRES_DB=arada_burger
POSTGRES_USER=arada_burger
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_PORT=5432

# Backend (host-side; Docker overrides DATABASE_URL — see docker-compose.yml)
DATABASE_URL=postgresql://arada_burger:change_me_dev_password@localhost:5432/arada_burger
NODE_ENV=development
PORT=4000
# Browser origin allowed to call the API — the frontend app (which includes
# /admin) is published on this origin.
CORS_ORIGIN=http://localhost:3000

# Frontend (includes the public site and /admin)
# Read by the browser, baked in at build time — leave as localhost since
# that's what's published to the host, whether this runs via Docker or
# `npm run dev`.
NEXT_PUBLIC_API_URL=http://localhost:4000
