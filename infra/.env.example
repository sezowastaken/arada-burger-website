# Copy to infra/.env before running `docker compose up`.
# These values are used both to configure the postgres container and to build
# the backend's DATABASE_URL (see docker-compose.yml) — set them once here.
# Never commit the real infra/.env file.

# PostgreSQL
POSTGRES_DB=arada_burger
POSTGRES_USER=arada_burger
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_PORT=5432

# Backend
NODE_ENV=development
PORT=4000
