# For running the backend directly on the host (npm run dev / npm start),
# connecting to a PostgreSQL instance on localhost.
#
# Running the full stack via Docker Compose instead? Use infra/.env.example —
# DATABASE_URL there is derived automatically to point at the `postgres` service.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arada_burger
